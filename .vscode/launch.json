{
  // Run and Debug panel (Ctrl+Shift+D): pick a configuration and press F5.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Sindhi web app",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/serve.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Spell-check a sentence (CLI)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["سنڌى ٻوللي دنيا جي قديمم ٻولين مان هڪ آهي"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {"PYTHONIOENCODING": "utf-8"}
    }
  ]
}
